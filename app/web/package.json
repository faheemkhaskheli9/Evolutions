{
  "name": "evolutions-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "cd ../../engine && cargo build -p evo-wasm --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir ../app/web/src/wasm target/wasm32-unknown-unknown/release/evo_wasm.wasm",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node e2e/smoke.mjs",
    "screenshots": "node e2e/guide-screenshots.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright-core": "^1.48.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
