{
  "name": "evolutions-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "cd ../../engine && cargo build -p evo-wasm --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir ../app/web/src/wasm target/wasm32-unknown-unknown/release/evo_wasm.wasm",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node e2e/smoke.mjs",
    "screenshots": "node e2e/guide-screenshots.mjs",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.2.6",
    "globals": "16.4.0",
    "playwright-core": "^1.48.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.46.0",
    "vite": "5.4.11",
    "vitest": "2.1.9"
  }
}
